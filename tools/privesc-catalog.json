{
  "_comment": "Privesc catalog shared by privesc.js / sliver.js / sshx.js. `checks` are AUTO-TIER read-only probes dispatched BY ID only (never freeform) — edit here to change what runs, nowhere else. `refs` are escalation references (technique/success-marker/note); no exploit code lives in this repo.",
  "checks": [
    { "id": "lin-sudo", "os": "linux", "title": "sudo rules (NOPASSWD / listed commands)", "cmds": ["sudo -n -l 2>&1"],
      "detect": [["NOPASSWD", "sudo-nopasswd", "High"], ["\\(root\\)", "sudo-root-cmds", "Medium"]] },
    { "id": "lin-suid", "os": "linux", "title": "SUID/SGID binaries (GTFOBins candidates)", "cmds": ["find / -xdev \\( -perm -4000 -o -perm -2000 \\) -type f 2>/dev/null"],
      "detect": [["/find$", "suid-find", "Critical"], ["/env$|/python[0-9.]*$|/perl$|/ruby$|/php$", "suid-interpreter", "High"], ["/nmap$|/vim|/bash$|/cp$|/mv$|/tar$|/mount$", "suid-gtfobins", "Medium"]] },
    { "id": "lin-caps", "os": "linux", "title": "POSIX file capabilities", "cmds": ["getcap -r / 2>/dev/null | head -40"],
      "detect": [["cap_setuid", "caps-setuid", "Critical"], ["cap_dac_read_search|cap_dac_override", "caps-dac", "High"], ["cap_net_raw", "caps-net-raw", "Low"]] },
    { "id": "lin-writable-etc", "os": "linux", "title": "writable files under /etc", "cmds": ["find /etc -writable -type f 2>/dev/null | head -20"],
      "detect": [["/passwd|/shadow|/sudoers|/crontab|/fstab", "etc-core-write", "Critical"], [".", "etc-other-write", "Medium"]] },
    { "id": "lin-writable-path", "os": "linux", "title": "world-writable dirs on PATH", "cmds": ["echo $PATH; ls -ld $(echo $PATH | tr ':' ' ') 2>/dev/null"],
      "detect": [["drwxrwxrwx", "path-hijack", "High"]] },
    { "id": "lin-cron", "os": "linux", "title": "cron jobs (writable job targets)", "cmds": ["crontab -l 2>&1; ls -la /etc/cron.d /etc/cron.daily /var/spool/cron 2>/dev/null"],
      "detect": [["\\* \\* \\* \\*", "cron-present", "Low"]] },
    { "id": "lin-kernel", "os": "linux", "title": "kernel version (LPE exposure map)", "cmds": ["uname -r; head -2 /etc/os-release 2>/dev/null"],
      "detect": [["^[5-6]\\.[0-9]+", "kernel-version", "Info"]] },
    { "id": "lin-groups", "os": "linux", "title": "privileged group membership (docker/lxd/disk)", "cmds": ["id"],
      "detect": [["\\(docker\\)", "docker-group-root", "Critical"], ["\\(lxd\\)", "lxd-group-root", "Critical"], ["\\(disk\\)", "disk-group-read", "High"], ["\\(video\\)|\\(adm\\)", "group-read-access", "Low"]] },
    { "id": "lin-shadow", "os": "linux", "title": "/etc/shadow readability", "cmds": ["ls -la /etc/passwd /etc/shadow 2>&1"],
      "detect": [["-rw", "shadow-perms-review", "Medium"]] },
    { "id": "lin-tmux", "os": "linux", "title": "foreign tmux/screen sockets (hijackable)", "cmds": ["ls -la /tmp/tmux-* /var/run/screen /run/tmux 2>/dev/null"],
      "detect": [["tmux-[0-9]+/", "tmux-socket", "Medium"], ["screen", "screen-sockets", "Low"]] },
    { "id": "lin-sshkeys", "os": "linux", "title": "readable SSH keys of other users", "cmds": ["ls -la /root/.ssh ~/.ssh /home/*/.ssh 2>/dev/null"],
      "detect": [["id_rsa|\\.pem", "ssh-key-readable", "High"]] },

    { "id": "win-privs", "os": "windows", "title": "token privileges (potato / backup / debug)", "cmds": ["whoami /priv"],
      "detect": [["SeImpersonatePrivilege\\s+Enabled", "seimpersonate-potato", "Critical"], ["SeAssignPrimaryTokenPrivilege\\s+Enabled", "seassignprimarytoken-potato", "Critical"], ["SeBackupPrivilege\\s+Enabled", "sebackup-shadowcopy", "High"], ["SeDebugPrivilege\\s+Enabled", "sedebug-inject", "High"], ["SeLoadDriverPrivilege\\s+Enabled", "seloaddriver", "Medium"]] },
    { "id": "win-aie", "os": "windows", "title": "AlwaysInstallElevated (MSI as SYSTEM)", "cmds": ["reg query HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer /v AlwaysInstallElevated 2>&1 & reg query HKCU\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer /v AlwaysInstallElevated 2>&1"],
      "detect": [["0x1", "always-install-elevated", "Critical"]] },
    { "id": "win-services", "os": "windows", "title": "SYSTEM services (unquoted/writable paths)", "cmds": ["powershell -nop -c \"Get-CimInstance Win32_Service | Where-Object {$_.StartName -match 'LocalSystem'} | Select-Object Name,PathName | Format-List\""],
      "detect": [["\"\\s", "unquoted-service-path", "Medium"], ["Program Files \\(x86\\)", "service-path-review", "Info"]] },
    { "id": "win-tasks", "os": "windows", "title": "scheduled tasks (SYSTEM context)", "cmds": ["schtasks /query /fo LIST 2>&1 | findstr /i \"TaskName Run As User\""],
      "detect": [["System|SYSTEM", "system-task", "Low"]] },
    { "id": "win-autorun", "os": "windows", "title": "autoruns registry (writable key hijack)", "cmds": ["reg query HKLM\\Software\\Microsoft\\Windows\\CurrentVersion\\Run 2>&1 & reg query HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run 2>&1"],
      "detect": [["REG_SZ", "autorun-present", "Low"]] },
    { "id": "win-storedcreds", "os": "windows", "title": "stored credentials (runas /savecred)", "cmds": ["cmdkey /list"],
      "detect": [["Target:", "stored-credentials", "Medium"]] },
    { "id": "win-defender", "os": "windows", "title": "Defender exclusions (drop-zone intel)", "cmds": ["powershell -nop -c \"Get-MpPreference | Select-Object ExclusionPath,ExclusionProcess | Format-List\""],
      "detect": [["ExclusionPath\\s+:\\s+\\S", "defender-exclusion-dir", "Medium"]] },
    { "id": "win-uac", "os": "windows", "title": "UAC level (silent elevation?)", "cmds": ["reg query HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System /v ConsentPromptBehaviorAdmin 2>&1 & reg query HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System /v EnableLUA 2>&1"],
      "detect": [["ConsentPromptBehaviorAdmin\\s+REG_DWORD\\s+0x0", "uac-silent-elevation", "High"], ["EnableLUA\\s+REG_DWORD\\s+0x0", "uac-disabled", "Medium"]] }
  ],
  "refs": {
    "lin-dirtypipe":   { "os": "linux", "technique": "T1068", "cve": "CVE-2022-0847", "success": "\\buid=0\\b", "note": "kernel 5.8-5.16.11 pipe-buffer flag overwrite; operator-supplied static binary; verify uid 0 afterwards." },
    "lin-chimera":     { "os": "linux", "technique": "T1068", "cve": "multi (July 2026 kernel set)", "success": "\\buid=0\\b", "note": "chimera-lpe-chain curated kernel PoCs (git.churchofmalware.org/ek0mssavi0r/chimera-lpe-chain). Vet + compile in lab FIRST; one CVE module at a time." },
    "lin-skeletonkey": { "os": "linux", "technique": "T1068", "cve": "multi (41 CVEs)", "success": "\\buid=0\\b", "note": "SKELETONKEY curated LPE bundle; --auto picks the safest module. Operator-supplied binary." },
    "lin-custom":      { "os": "linux", "technique": "T1068", "cve": null, "success": "\\buid=0\\b", "note": "agent-derived escalation from check output (GTFOBins recipe, sudo rule abuse, capsh recipe, writable cron/job path)." },
    "win-potato":      { "os": "windows", "technique": "T1134", "cve": null, "success": "S-1-16-12288|SYSTEM", "note": "SeImpersonate/SeAssignPrimaryToken -> potato family (GodPotato/SweetPotato). Operator-supplied binary." },
    "win-msi-aie":     { "os": "windows", "technique": "T1053", "cve": null, "success": "S-1-16-12288|SYSTEM", "note": "AlwaysInstallElevated: craft MSI + msiexec /qn /i. Requires HKLM AND HKCU values = 0x1." },
    "win-savecred":    { "os": "windows", "technique": "T1003", "cve": null, "success": "S-1-16-12288", "note": "runas /savecred against a stored credential to launch an elevated process." },
    "win-custom":      { "os": "windows", "technique": "T1068", "cve": null, "success": "S-1-16-12288", "note": "agent-derived escalation from check output (service path, task hijack, autorun key)." }
  }
}
